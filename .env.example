# Marketing (existing)
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/yusufayomide267/30min
NEXT_PUBLIC_FORMSPREE_ID=mwlkbqoe
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# Research writer — server only. Do not prefix secrets with NEXT_PUBLIC_.
# MongoDB Atlas connection string (least-privilege user).
MONGODB_URI=

# LLM providers. OpenAI is the primary; OpenRouter is an optional fallback.
# Defaults: gpt-5.6-terra / gpt-5.6-luna.
# Do not set OPENAI_WRITING_MODEL or OPENAI_UTILITY_MODEL to the bare gpt-5.6 alias.
OPENAI_API_KEY=
OPENAI_WRITING_MODEL=
OPENAI_UTILITY_MODEL=
# Optional OpenAI base URL override (default https://api.openai.com/v1).
OPENAI_BASE_URL=

# OpenRouter fallback (OpenAI-compatible). Set this to run when OpenAI fails
# or to use OpenRouter alone. LLM_API_KEY is accepted as an alias.
OPENROUTER_API_KEY=
LLM_API_KEY=
OPENROUTER_BASE_URL=
# Optional OpenRouter model slugs (default: openai/<model> for each OpenAI model).
OPENROUTER_WRITING_MODEL=
OPENROUTER_UTILITY_MODEL=
# Set to "openrouter" to make OpenRouter primary instead of the fallback.
LLM_PRIMARY=
# Per-request LLM timeouts in milliseconds (abort a hung provider request).
LLM_TIMEOUT_MS=
LLM_UTILITY_TIMEOUT_MS=

# Bachs sandbox or live. Webhook HMAC secret is required for payment confirmation.
BACHS_API_KEY=
BACHS_WEBHOOK_SECRET=
BACHS_API_BASE_URL=
BACHS_PRODUCT_ID=

# Canonical public URL for payment return links. Local: http://localhost:3000
APP_BASE_URL=

# Secret mixed into recovery-token hashes. Never expose to the client.
RECOVERY_TOKEN_PEPPER=

# Polite Crossref contact (required for C13 matching). OpenAlex key optional.
# CROSSREF_CONTACT_EMAIL=you@example.com
CROSSREF_CONTACT_EMAIL=
OPENALEX_API_KEY=

# Optional recovery email.
EMAIL_API_KEY=
EMAIL_FROM=

# Research rate limits. Set RESEARCH_RATE_LIMIT_STORE=mongo in production so the
# window is shared across serverless instances (falls back to per-instance
# memory if the store is unreachable). Leave unset in dev/test.
RESEARCH_RATE_LIMIT_STORE=
# Secret for the scheduled retention purge route (Vercel Cron sends this as a
# bearer token). RESEARCH_RETENTION_DAYS defaults to 365.
CRON_SECRET=
RESEARCH_RETENTION_DAYS=
# Set OpenAI project spend alerts in the OpenAI dashboard. Optional process-local warn:
# RESEARCH_DAILY_TOKEN_WARN=500000
RESEARCH_DAILY_TOKEN_WARN=

# Retention: papers may be deleted 12 months after last update.
# Dry-run: pnpm research:delete-paper --publicId=pap_…   or  --expired
# Delete:  add --apply


# Wizard step gating. Default is true when unset. Set false locally to
# open Sources and Review with empty fields. Checkout and order create
# still require a valid draft. Set true or delete this line for production.
NEXT_PUBLIC_RESEARCH_WIZARD_STRICT=

# Pricing. Money is stored as kobo (1 naira = 100 kobo).
# Defaults: ₦250 per page, ₦2,500 minimum (10 pages).
# WORDS_PER_PAGE=300
# PRICE_PER_PAGE_CENTS=25000
# MINIMUM_ORDER_CENTS=250000
# RESEARCH_CURRENCY=NGN
# MIN_PAGES=10
# MAX_PAGES=40
# MAX_REFERENCES=25
# MAX_ADDITIONAL_SOURCES=5
# REGENERATION_LIMIT=3
WORDS_PER_PAGE=
PRICE_PER_PAGE_CENTS=
MINIMUM_ORDER_CENTS=
RESEARCH_CURRENCY=
MIN_PAGES=
MAX_PAGES=
MAX_REFERENCES=
REGENERATION_LIMIT=
